#-------------------------------------------------------------------------------
# Rust file-based heuristics
#-------------------------------------------------------------------------------

# Relevant crates for FFI builds
CRATES := crypto crypto-ffi keystore crypto-macros e2e-identity obfuscate

# Directory with language specific bindings
BINDINGS_DIR= $(abspath crypto-ffi/bindings)

# Workspace-level Cargo config
WORKSPACE_CARGO_FILES := Cargo.toml Cargo.lock

# Per-crate manifests
CRATE_MANIFESTS := $(addsuffix /Cargo.toml,$(CRATES))

# Enumerate the .rs files of the crates above, skipping anything ignored by our
# `.gitignore` (`fd` default behavior). Other workspace members, such as
# `interop`, aren't part of the FFI library, so changing them must not
# invalidate its artifacts.
RUST_RS_FILES := $(shell fd --type f --extension rs . $(CRATES) | LC_ALL=C sort)

# The keystore compiles its SQL migrations and the composite schema into the
# library (`embed_migrations!` and `include_str!`), so a change to any of them
# changes the build even when no `.rs` file does.
KEYSTORE_SQL_FILES := $(shell fd --type f --extension sql . keystore/src | LC_ALL=C sort)

# Files relevant to build interop, beyond `RUST_SOURCES`
INTEROP_RS_FILES := $(shell fd --type f --extension rs . interop | LC_ALL=C sort)
INTEROP_TS_FILES := $(shell fd --type f --extension ts . interop | LC_ALL=C sort)
INTEROP_MANIFEST := interop/Cargo.toml

# Complete dependency set for FFI-related Cargo builds
RUST_SOURCES := $(WORKSPACE_CARGO_FILES) $(CRATE_MANIFESTS) $(RUST_RS_FILES) $(KEYSTORE_SQL_FILES)

# Dependency set for tasks that run cargo over the whole workspace (formatting,
# linting, docs), so they need to see every member's .rs files
WORKSPACE_RS_FILES := $(shell fd --type f --extension rs | LC_ALL=C sort)
WORKSPACE_RUST_SOURCES := $(WORKSPACE_CARGO_FILES) $(CRATE_MANIFESTS) $(WORKSPACE_RS_FILES) $(KEYSTORE_SQL_FILES)

# Uniffi binding configs. uniffi-bindgen finds the crate's own `uniffi.toml` through cargo metadata. A `--config` file
# is a global config, whose `[crates.<lib name>]` tables are merged over the crate's own `uniffi.toml`.
UNIFFI_TOML := crypto-ffi/uniffi.toml
UNIFFI_ANDROID_TOML := crypto-ffi/uniffi-android.toml

# Used by CI to calculate a hash of prerequisite files of a make rule
%-hash-deps:
	@if [ -z "$($*-deps)" ]; then \
	  echo "ERROR: The \"$*-deps\" variable doesn't exist in the Makefile."; exit 1; \
	fi
	@set -euo pipefail; \
	hash=$$(sha256sum $($*-deps) | awk '{print $$1}' | sha256sum | awk '{print $$1}'); \
	echo "$$hash"

#-------------------------------------------------------------------------------
# Kotlin file-based heuristics
#-------------------------------------------------------------------------------
KT_WRAPPER = $(BINDINGS_DIR)/shared/src/commonMain/kotlin
KT_TESTS = $(BINDINGS_DIR)/shared/src/commonTest
KT_BENCHMARKS = $(BINDINGS_DIR)/jvm/src/jmh/
KT_FILES := $(shell fd --type f --extension kt . | LC_ALL=C sort)
KT_GRADLE_FILES = $(shell fd --type f --extension kts . | LC_ALL=C sort)
# Everything that configures the Gradle build, so that test results are invalidated when the build changes
KT_BUILD_FILES = $(KT_GRADLE_FILES) \
  $(shell fd --type f --glob gradle.properties crypto-ffi/bindings | LC_ALL=C sort) \
  crypto-ffi/bindings/gradle/libs.versions.toml \
  crypto-ffi/bindings/gradle/wrapper/gradle-wrapper.properties
KT_DETEKT_CONFIG = $(BINDINGS_DIR)/detekt.yml

#-------------------------------------------------------------------------------
# Swift file-based heuristics
#-------------------------------------------------------------------------------

SWIFT_INTEROP = ./interop/src/clients/InteropClient
SWIFT_WRAPPER = ./crypto-ffi/bindings/swift/WireCoreCrypto/WireCoreCrypto
SWIFT_TESTS = ./crypto-ffi/bindings/swift/WireCoreCrypto/WireCoreCryptoTests
SWIFT_FILES := $(shell fd --type f --extension swift . | LC_ALL=C sort)

#-------------------------------------------------------------------------------
# TypeScript file-based heuristics
#-------------------------------------------------------------------------------

JS_DIR := $(abspath crypto-ffi/bindings/js)
TS_SHARED_DIR := $(JS_DIR)/shared
TS_BROWSER_DIR := $(JS_DIR)/packages/browser
TS_NATIVE_DIR := $(JS_DIR)/packages/native
TS_SHARED_SRC_DIR := $(TS_SHARED_DIR)/src
BROWSER_SRC_DIR := $(TS_BROWSER_DIR)/src
TS_NATIVE_SRC_DIR := $(TS_NATIVE_DIR)/src
PACKAGE_JSONS := $(JS_DIR)/package.json $(TS_BROWSER_DIR)/package.json $(TS_NATIVE_DIR)/package.json
BUN_LOCK := $(JS_DIR)/bun.lock
BUNFIG := $(JS_DIR)/bunfig.toml
UBRN_CONFIG := $(JS_DIR)/ubrn.config.yaml

BROWSER_GEN_DIR := $(BROWSER_SRC_DIR)/autogenerated
TS_NATIVE_GEN_DIR := $(TS_NATIVE_SRC_DIR)/autogenerated

# find all .ts source files under src/ except `*.d.ts`
TS_SHARED_SRCS := $(shell fd --type f --extension ts --exclude '*.d.ts' . $(TS_SHARED_SRC_DIR) | LC_ALL=C sort)
TS_NATIVE_SRCS := $(TS_SHARED_SRCS) $(shell fd --type f --extension ts --exclude '*.d.ts' --exclude '*autogenerated*' . $(TS_NATIVE_SRC_DIR) | LC_ALL=C sort)
TS_BROWSER_SRCS := $(TS_SHARED_SRCS) $(shell fd --type f --extension ts --exclude '*.d.ts' --exclude '*autogenerated*' . $(BROWSER_SRC_DIR) | LC_ALL=C sort)
TS_SRCS := $(TS_SHARED_SRCS) $(TS_NATIVE_SRCS) $(TS_BROWSER_SRCS)

TS_NATIVE_TEST_FILES := $(shell fd --type f --extension ts . $(TS_NATIVE_DIR)/test | LC_ALL=C sort)
TS_NATIVE_SHARED_FILES := $(shell fd --type f --extension ts . $(TS_NATIVE_DIR)/shared | LC_ALL=C sort)
TS_BROWSER_TEST_FILES := $(shell fd --type f --extension ts . $(TS_BROWSER_DIR)/test | LC_ALL=C sort)
TS_BROWSER_SHARED_FILES := $(shell fd --type f --extension ts . $(TS_BROWSER_DIR)/shared | LC_ALL=C sort)
TS_SHARED_TEST_FILES := $(shell fd --type f --extension ts . $(TS_SHARED_DIR)/test | LC_ALL=C sort)
TS_SHARED_SHARED_FILES := $(shell fd --type f --extension ts . $(TS_SHARED_DIR)/shared | LC_ALL=C sort)
TS_NATIVE_BENCH_FILES := $(shell fd --type f --extension ts . $(TS_NATIVE_DIR)/benches | LC_ALL=C sort)
TS_BROWSER_BENCH_FILES := $(shell fd --type f --extension ts . $(TS_BROWSER_DIR)/benches | LC_ALL=C sort)
TS_SHARED_BENCH_FILES := $(shell fd --type f --extension ts . $(TS_SHARED_DIR)/benches | LC_ALL=C sort)

TS_TEST_FILES := $(sort $(TS_NATIVE_TEST_FILES) $(TS_NATIVE_SHARED_FILES) $(TS_BROWSER_TEST_FILES) $(TS_BROWSER_SHARED_FILES) $(TS_SHARED_BENCH_FILES) $(TS_SHARED_SHARED_FILES))
TS_BENCH_FILES := $(sort $(TS_NATIVE_BENCH_FILES) $(TS_NATIVE_SHARED_FILES) $(TS_BROWSER_BENCH_FILES) $(TS_BROWSER_SHARED_FILES) $(TS_SHARED_BENCH_FILES) $(TS_SHARED_SHARED_FILES))
JSON_FILES := $(shell fd --type f --extension json . $(JS_DIR) | LC_ALL=C sort)

# JS snippets that wasm-bindgen bundles into the keystore, type-checked by tsc
KEYSTORE_JS_DIR := $(abspath keystore)
KEYSTORE_JS_SRCS := $(shell fd --type f --extension js . $(KEYSTORE_JS_DIR)/src | LC_ALL=C sort)
