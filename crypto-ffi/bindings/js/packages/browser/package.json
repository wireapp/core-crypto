{
    "name": "@wireapp/core-crypto",
    "version": "11.0.0-pre.5",
    "description": "CoreCrypto bindings for browser JavaScript runtimes",
    "keywords": [
        "corecrypto",
        "e2ee",
        "mls",
        "proteus",
        "wire"
    ],
    "homepage": "https://github.com/wireapp/core-crypto",
    "bugs": {
        "url": "https://github.com/wireapp/core-crypto/issues"
    },
    "license": "GPL-3.0",
    "author": "Wire CoreCrypto team <team.corecrypto@wire.com>",
    "repository": {
        "type": "git",
        "url": "git@github.com:wireapp/core-crypto.git"
    },
    "files": [
        "dist/corecrypto.js",
        "dist/corecrypto.d.ts",
        "dist/autogenerated/wasm-bindgen/index_bg.wasm",
        "dist/autogenerated/wasm-bindgen/index_bg.wasm.d.ts"
    ],
    "type": "module",
    "types": "./dist/corecrypto.d.ts",
    "typesVersions": {
        "*": {
            "browser": [
                "./dist/corecrypto.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "types": "./dist/corecrypto.d.ts",
            "import": "./dist/corecrypto.js"
        },
        "./browser": {
            "types": "./dist/corecrypto.d.ts",
            "import": "./dist/corecrypto.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@ubjs/core": "https://github.com/wireapp/uniffi-bindgen-react-native/releases/download/0.31.0-5.wire.1/ubjs-core-0.31.0-5.wire.1.tgz",
        "@ubjs/wasm": "https://github.com/wireapp/uniffi-bindgen-react-native/releases/download/0.31.0-5.wire.1/ubjs-wasm-0.31.0-5.wire.1.tgz"
    }
}
